{
  "compilerOptions": {
    "target": "ES2019",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2019", "DOM"],
    "declaration": true,
    "declarationDir": "dist",
    "sourceMap": true,
    "strict": true,
    "noImplicitOverride": false,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "types": ["node"],
    "outDir": ".ts-build"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", ".test-dist"]
}
